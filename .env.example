# Copy this file to .env and fill in the values from Feishu Developer Console.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Message used to bind your Feishu account to this local bridge.
FEISHU_BIND_COMMAND=绑定

# Local-only HTTP endpoint used by Codex hooks.
BRIDGE_HTTP_PORT=8765

# Wait up to 20 minutes for a Feishu approval before returning to local approval.
CODEX_APPROVAL_TIMEOUT_MS=1200000

# Wait for request_user_input answers from Feishu before falling back to the local window.
CODEX_INPUT_TIMEOUT_MS=1200000

# Sessions seen within this period are shown as active (24 hours by default).
CODEX_SESSION_ACTIVE_MS=86400000

# Assistant-created session groups are dissolved after 7 days without session activity.
# Cleanup runs hourly. Set milliseconds here if you need a different retention period.
FEISHU_SESSION_GROUP_INACTIVE_MS=604800000
FEISHU_SESSION_GROUP_CLEANUP_INTERVAL_MS=3600000

# Wait up to 2 minutes for the desktop panel to auto-open a closed CLI session.
RUNTIME_AUTO_LAUNCH_TIMEOUT_MS=120000

# Usually keep this as codex. Set an absolute executable only if Codex is not on PATH.
CODEX_COMMAND=codex

# Inbound Feishu attachments are stored under data/uploads and expire after 7 days.
FEISHU_INBOUND_FILE_MAX_BYTES=26214400
FEISHU_INBOUND_ATTACHMENT_MAX_COUNT=4
FEISHU_UPLOAD_TTL_MS=604800000

# Explicit Codex file returns are limited to 30 MiB and must remain inside the session cwd.
FEISHU_OUTBOUND_FILE_MAX_BYTES=31457280

# Automatically discover and connect to opencode servers already running on this machine
# (any opencode started with a visible port, e.g. via the desktop button or `opencode --port 5101`).
# Set to 0 to disable; the interval controls how often localhost ports are rescanned.
OPENCODE_AUTO_DISCOVER=1
OPENCODE_AUTO_DISCOVER_INTERVAL_MS=20000

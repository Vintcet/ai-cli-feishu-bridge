<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.8.3" />
    <PackageReference Include="MSTest.TestFramework" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="cutover-host-fixture\CutoverHostFixture.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\bridge-dotnet\src\AiCliFeishu.Bridge.Adapters.Storage\AiCliFeishu.Bridge.Adapters.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\RuntimeProfile.cs" Link="RuntimeProfile.cs" />
    <Compile Include="..\RuntimeArgumentParser.cs" Link="RuntimeArgumentParser.cs" />
    <Compile Include="..\TerminalInputParser.cs" Link="TerminalInputParser.cs" />
    <Compile Include="..\ManagedTerminalHost.cs" Link="ManagedTerminalHost.cs" />
    <Compile Include="..\Models.cs" Link="Models.cs" />
    <Compile Include="..\BridgeHostTarget.cs" Link="BridgeHostTarget.cs" />
    <Compile Include="..\BridgeHostExitWaiter.cs" Link="BridgeHostExitWaiter.cs" />
    <Compile Include="..\BridgeHostCutoverTransaction.cs" Link="BridgeHostCutoverTransaction.cs" />
    <Compile Include="..\BridgeHostCutoverCoordinator.cs" Link="BridgeHostCutoverCoordinator.cs" />
    <Compile Include="..\BridgeHostPersistentCutoverCoordinator.cs" Link="BridgeHostPersistentCutoverCoordinator.cs" />
    <Compile Include="..\BridgeHostCutoverProcessOperations.cs" Link="BridgeHostCutoverProcessOperations.cs" />
    <Compile Include="..\BridgeHostCutoverCheckpoint.cs" Link="BridgeHostCutoverCheckpoint.cs" />
    <Compile Include="..\BridgeHostCutoverCheckpointStore.cs" Link="BridgeHostCutoverCheckpointStore.cs" />
    <Compile Include="..\BridgeHostCutoverCheckpointRecovery.cs" Link="BridgeHostCutoverCheckpointRecovery.cs" />
    <Compile Include="..\BridgeHostCutoverCheckpointWriter.cs" Link="BridgeHostCutoverCheckpointWriter.cs" />
    <Compile Include="..\BridgeHostRecoveryPlan.cs" Link="BridgeHostRecoveryPlan.cs" />
    <Compile Include="..\BridgeHostRecoveryObserver.cs" Link="BridgeHostRecoveryObserver.cs" />
    <Compile Include="..\BridgeHostRecoveryExecutor.cs" Link="BridgeHostRecoveryExecutor.cs" />
    <Compile Include="..\ProductionBridgeStoreHandoffInspector.cs" Link="ProductionBridgeStoreHandoffInspector.cs" />
    <Compile Include="..\BridgeHostProductionCutover.cs" Link="BridgeHostProductionCutover.cs" />
    <Compile Include="..\BridgeHostProductionTargetSelector.cs" Link="BridgeHostProductionTargetSelector.cs" />
    <Compile Include="..\BridgeHostStartupRecovery.cs" Link="BridgeHostStartupRecovery.cs" />
    <Compile Include="BridgeHostCutoverTransactionTests.cs" />
    <Compile Include="BridgeHostCutoverCoordinatorTests.cs" />
    <Compile Include="BridgeHostPersistentCutoverCoordinatorTests.cs" />
    <Compile Include="BridgeHostCutoverProcessOperationsTests.cs" />
    <Compile Include="BridgeHostCutoverProcessIntegrationTests.cs" />
    <Compile Include="BridgeHostRecoveryProcessIntegrationTests.cs" />
    <Compile Include="BridgeHostCutoverCheckpointTests.cs" />
    <Compile Include="BridgeHostCutoverCheckpointWriterTests.cs" />
    <Compile Include="BridgeHostRecoveryPlanTests.cs" />
    <Compile Include="BridgeHostRecoveryObserverTests.cs" />
    <Compile Include="BridgeHostRecoveryExecutorTests.cs" />
    <Compile Include="ProductionBridgeStoreHandoffInspectorTests.cs" />
    <Compile Include="BridgeHostProductionCutoverTests.cs" />
    <Compile Include="BridgeHostProductionTargetSelectorTests.cs" />
    <Compile Include="BridgeHostStartupRecoveryTests.cs" />
  </ItemGroup>

  <Target Name="CopyCutoverHostFixture" AfterTargets="Build">
    <PropertyGroup>
      <CutoverHostFixtureOutputDirectory>$(MSBuildThisFileDirectory)cutover-host-fixture\bin\$(Configuration)\net8.0\</CutoverHostFixtureOutputDirectory>
    </PropertyGroup>
    <ItemGroup>
      <CutoverHostFixtureFiles Include="$(CutoverHostFixtureOutputDirectory)CutoverHostFixture.*" />
    </ItemGroup>
    <Copy SourceFiles="@(CutoverHostFixtureFiles)"
          DestinationFolder="$(OutDir)cutover-host-fixture\"
          SkipUnchangedFiles="true" />
  </Target>
</Project>

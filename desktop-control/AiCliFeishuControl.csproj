<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\ai-cli-feishu.ico</ApplicationIcon>
    <AssemblyName>AiCliFeishuControl</AssemblyName>
    <RootNamespace>AiCliFeishuControl</RootNamespace>
    <Product>AI CLI Feishu Assistant</Product>
    <Title>AI CLI Feishu Assistant</Title>
    <Description>Windows desktop bridge for Codex, Claude Code, OpenCode, and Feishu.</Description>
    <Version>0.20.0</Version>
    <AssemblyVersion>0.20.0.0</AssemblyVersion>
    <FileVersion>0.20.0.0</FileVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="terminal-host\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <ProjectReference Include="terminal-host\AiCliFeishuTerminalHost.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\bridge-dotnet\src\AiCliFeishu.Bridge.Host\AiCliFeishu.Bridge.Host.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\bridge-dotnet\src\AiCliFeishu.Bridge.Adapters.Storage\AiCliFeishu.Bridge.Adapters.Storage.csproj" />
  </ItemGroup>

  <Target Name="CopyTerminalHostToOutput" AfterTargets="Build">
    <PropertyGroup>
      <TerminalHostOutputDirectory>$(MSBuildThisFileDirectory)terminal-host\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)</TerminalHostOutputDirectory>
    </PropertyGroup>
    <ItemGroup>
      <TerminalHostOutputFiles Include="$(TerminalHostOutputDirectory)\AiCliFeishuTerminalHost.*" />
    </ItemGroup>
    <Copy SourceFiles="@(TerminalHostOutputFiles)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(TerminalHostOutputDirectory)')" />
  </Target>

  <Target Name="PublishTerminalHost" AfterTargets="Publish">
    <PropertyGroup>
      <TerminalHostPublishDirectory>$(MSBuildThisFileDirectory)terminal-host\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish-sidecar\</TerminalHostPublishDirectory>
    </PropertyGroup>
    <MSBuild Projects="$(MSBuildThisFileDirectory)terminal-host\AiCliFeishuTerminalHost.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);PublishDir=$(TerminalHostPublishDirectory);PublishSingleFile=true;SelfContained=false" />
    <Copy SourceFiles="$(TerminalHostPublishDirectory)AiCliFeishuTerminalHost.exe"
          DestinationFolder="$(PublishDir)" />
    <Delete Files="$(PublishDir)AiCliFeishuTerminalHost.dll;$(PublishDir)AiCliFeishuTerminalHost.deps.json;$(PublishDir)AiCliFeishuTerminalHost.runtimeconfig.json" />
  </Target>

  <Target Name="PublishBridgeHost" AfterTargets="Publish">
    <PropertyGroup>
      <BridgeHostProject>$(MSBuildThisFileDirectory)..\bridge-dotnet\src\AiCliFeishu.Bridge.Host\AiCliFeishu.Bridge.Host.csproj</BridgeHostProject>
      <BridgeHostPublishDirectory>$(MSBuildThisFileDirectory)..\bridge-dotnet\src\AiCliFeishu.Bridge.Host\bin\$(Configuration)\net8.0\$(RuntimeIdentifier)\publish-sidecar\</BridgeHostPublishDirectory>
      <BridgeHostExecutable>$(BridgeHostPublishDirectory)AiCliFeishuBridgeHost.exe</BridgeHostExecutable>
    </PropertyGroup>
    <MSBuild Projects="$(BridgeHostProject)"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);PublishDir=$(BridgeHostPublishDirectory);PublishSingleFile=true;SelfContained=false;Version=$(Version);AssemblyVersion=$(AssemblyVersion);FileVersion=$(FileVersion);DebugType=none;DebugSymbols=false" />
    <Error Condition="!Exists('$(BridgeHostExecutable)')"
           Text="Bridge Host sidecar publish did not produce $(BridgeHostExecutable)." />
    <Copy SourceFiles="$(BridgeHostExecutable)"
          DestinationFolder="$(PublishDir)" />
    <Delete Files="$(PublishDir)AiCliFeishuBridgeHost.dll;$(PublishDir)AiCliFeishuBridgeHost.deps.json;$(PublishDir)AiCliFeishuBridgeHost.runtimeconfig.json;$(PublishDir)AiCliFeishuBridgeHost.pdb" />
  </Target>
</Project>

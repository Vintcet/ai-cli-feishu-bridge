{
  "name": "ai-cli-feishu-bridge",
  "version": "0.19.1",
  "private": true,
  "description": "A Windows-local bridge for Feishu notifications, approvals, questions, and conversation control across Codex CLI, Claude Code, and OpenCode.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vintcet/ai-cli-feishu-bridge.git"
  },
  "homepage": "https://github.com/Vintcet/ai-cli-feishu-bridge#readme",
  "bugs": {
    "url": "https://github.com/Vintcet/ai-cli-feishu-bridge/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "format:check": "node scripts/check-format.mjs",
    "check": "npm run lint && npm run format:check",
    "test": "tsx --test --test-concurrency=1 test/**/*.test.ts",
    "start": "node dist/index.js",
    "release:zip": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}

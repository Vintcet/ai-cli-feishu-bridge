{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-cli-feishu.local/protocol/ownership/v1/active-owner-lease.schema.json",
  "title": "AI CLI Feishu Production Store Active Owner Lease",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": 1 },
    "hostKind": { "type": "string", "enum": ["node", "dotnet"] },
    "ownershipMode": { "const": "active" },
    "processId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "instanceName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "leaseId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "acquiredAt": { "type": "string", "format": "date-time" }
  },
  "required": [
    "schemaVersion",
    "hostKind",
    "ownershipMode",
    "processId",
    "instanceName",
    "leaseId",
    "acquiredAt"
  ],
  "additionalProperties": false
}

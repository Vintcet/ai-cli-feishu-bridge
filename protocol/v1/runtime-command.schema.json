{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-cli-feishu.local/protocol/v1/runtime-command.schema.json",
  "title": "AI CLI Feishu Runtime Command",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "type": "object",
      "properties": {
        "commandId": { "type": "string", "minLength": 1 },
        "commandType": {
          "type": "string",
          "enum": [
            "prompt.send",
            "approval.resolve",
            "input.resolve",
            "session.launch",
            "session.resume",
            "session.stop"
          ]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "payload": { "type": "object" }
      },
      "required": ["commandId", "commandType", "createdAt", "payload"]
    },
    {
      "oneOf": [
        {
          "properties": {
            "commandType": { "const": "prompt.send" },
            "payload": {
              "type": "object",
              "properties": {
                "prompt": { "type": "string", "minLength": 1 },
                "mode": { "enum": ["steer", "queue"] }
              },
              "required": ["prompt", "mode"],
              "additionalProperties": false
            }
          }
        },
        {
          "properties": {
            "commandType": { "const": "approval.resolve" },
            "payload": {
              "type": "object",
              "properties": {
                "requestId": { "type": "string", "minLength": 1 },
                "decision": {
                  "enum": ["allow_once", "allow_session", "deny"]
                }
              },
              "required": ["requestId", "decision"],
              "additionalProperties": false
            }
          }
        },
        {
          "properties": {
            "commandType": { "const": "input.resolve" },
            "payload": {
              "type": "object",
              "properties": {
                "requestId": { "type": "string", "minLength": 1 },
                "answers": {
                  "type": "object",
                  "additionalProperties": {
                    "oneOf": [
                      { "type": "string" },
                      {
                        "type": "array",
                        "items": { "type": "string" }
                      }
                    ]
                  }
                }
              },
              "required": ["requestId", "answers"],
              "additionalProperties": false
            }
          }
        },
        {
          "properties": {
            "commandType": { "const": "session.launch" },
            "payload": {
              "type": "object",
              "properties": {
                "cwd": { "type": "string", "minLength": 1 },
                "prompt": { "type": "string" },
                "elevated": { "type": "boolean" }
              },
              "required": ["cwd"],
              "additionalProperties": false
            }
          }
        },
        {
          "properties": {
            "commandType": { "const": "session.resume" },
            "payload": {
              "type": "object",
              "properties": { "prompt": { "type": "string" } },
              "additionalProperties": false
            }
          }
        },
        {
          "properties": {
            "commandType": { "const": "session.stop" },
            "payload": {
              "type": "object",
              "properties": { "reason": { "type": "string" } },
              "additionalProperties": false
            }
          }
        }
      ]
    }
  ]
}

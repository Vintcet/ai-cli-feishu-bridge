<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
    <AssemblyName>AiCliFeishuBridgeHost</AssemblyName>
    <RootNamespace>AiCliFeishu.Bridge.Host</RootNamespace>
    <Product>AI CLI Feishu Assistant</Product>
    <Title>AI CLI Feishu Bridge Host</Title>
    <Description>Production .NET bridge host for AI CLI Feishu Assistant.</Description>
    <Version>0.20.0</Version>
    <AssemblyVersion>0.20.0.0</AssemblyVersion>
    <FileVersion>0.20.0.0</FileVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <!-- Framework-dependent on Sdk.Web means the host needs Microsoft.AspNetCore.App.
         A machine that has moved on to a newer major (having dropped the 8.x ASP.NET
         Core runtime while keeping 8.x NETCore/WindowsDesktop) would otherwise fail to
         start with "You must install or update .NET", even though the desktop panel
         still runs. Rolling forward keeps the host launchable on later majors. -->
    <RollForward>LatestMajor</RollForward>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AiCliFeishu.Bridge.Host.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AiCliFeishu.Bridge.Core\AiCliFeishu.Bridge.Core.csproj" />
    <ProjectReference Include="..\AiCliFeishu.Bridge.Adapters.Feishu\AiCliFeishu.Bridge.Adapters.Feishu.csproj" />
    <ProjectReference Include="..\AiCliFeishu.Bridge.Adapters.ManagedTerminal\AiCliFeishu.Bridge.Adapters.ManagedTerminal.csproj" />
    <ProjectReference Include="..\AiCliFeishu.Bridge.Adapters.OpenCode\AiCliFeishu.Bridge.Adapters.OpenCode.csproj" />
    <ProjectReference Include="..\AiCliFeishu.Bridge.Adapters.Storage\AiCliFeishu.Bridge.Adapters.Storage.csproj" />
  </ItemGroup>
</Project>

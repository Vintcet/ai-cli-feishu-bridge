<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
    <AssemblyName>AiCliFeishuBridgeHost</AssemblyName>
    <RootNamespace>AiCliFeishu.Bridge.Host</RootNamespace>
    <Product>AI CLI Feishu Assistant</Product>
    <Title>AI CLI Feishu Bridge Host</Title>
    <Description>Passive .NET bridge host for AI CLI Feishu Assistant.</Description>
    <Version>0.19.1</Version>
    <AssemblyVersion>0.19.1.0</AssemblyVersion>
    <FileVersion>0.19.1.0</FileVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AiCliFeishu.Bridge.Core\AiCliFeishu.Bridge.Core.csproj" />
    <ProjectReference Include="..\AiCliFeishu.Bridge.Adapters.Feishu\AiCliFeishu.Bridge.Adapters.Feishu.csproj" />
    <ProjectReference Include="..\AiCliFeishu.Bridge.Adapters.ManagedTerminal\AiCliFeishu.Bridge.Adapters.ManagedTerminal.csproj" />
    <ProjectReference Include="..\AiCliFeishu.Bridge.Adapters.OpenCode\AiCliFeishu.Bridge.Adapters.OpenCode.csproj" />
    <ProjectReference Include="..\AiCliFeishu.Bridge.Adapters.Storage\AiCliFeishu.Bridge.Adapters.Storage.csproj" />
  </ItemGroup>
</Project>
